{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "sample_rate",
    "media",
    "input_dir",
    "temp_dir"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "sample_rate": {
      "enum": [
        11025,
        22050
      ],
      "type": "integer"
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "file_path",
          "relative_path",
          "kind",
          "duration_seconds",
          "duration",
          "video",
          "audio_streams",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "file_path": {
            "type": "string",
            "minLength": 1
          },
          "relative_path": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "video",
              "audio"
            ]
          },
          "duration_seconds": {
            "type": "number",
            "minimum": 0
          },
          "duration": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ready",
              "no_audio",
              "extraction_failed",
              "error"
            ]
          },
          "video": {
            "type": [
              "object",
              "null"
            ]
          },
          "audio_streams": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "index",
                "channels",
                "sample_rate",
                "start_time",
                "duration"
              ],
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 0
                },
                "channels": {
                  "type": "integer",
                  "minimum": 1
                },
                "sample_rate": {
                  "type": "integer",
                  "minimum": 1
                },
                "start_time": {
                  "type": "string"
                },
                "duration": {
                  "type": "string"
                }
              }
            }
          },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "wav_path",
                "sample_rate",
                "origin_samples",
                "stream_index"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "wav_path": {
                  "type": "string"
                },
                "sample_rate": {
                  "enum": [
                    11025,
                    22050
                  ]
                },
                "origin_samples": {
                  "type": "integer"
                },
                "stream_index": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "input_dir": {
      "type": "string"
    },
    "temp_dir": {
      "type": "string"
    }
  }
}
